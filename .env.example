# ─────────────────────────────────────────────────────────────
# NOTE: docker-compose.yml now has NO required environment variables.
# You can run `docker compose up -d` directly without a .env file.
# This file is kept only as a reference.
# ─────────────────────────────────────────────────────────────

# Web UI is published on host port 13200 (container :3000).
# Change it in docker-compose.yml's `ports` if you need a different port.

# ComfyUI backend is configured in the WebUI (Settings -> ComfyUI), not here.
# From inside the container use a reachable address:
#   - ComfyUI on the Docker host      -> host.docker.internal:8188
#   - ComfyUI on another LAN machine  -> its LAN IP, e.g. 192.168.2.102:8188
