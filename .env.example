# ─────────────────────────────────────────────────────────────
# Copy this file to .env (same folder) and adjust if needed.
# All values already have working defaults in docker-compose.yml,
# so running `docker compose up -d` without a .env also works.
# ─────────────────────────────────────────────────────────────

# Host port for the web UI (maps to container :3000).
INFINITE_CANVAS_PORT=13200

# Published image (already set to the real one in compose default).
# Only change if you forked this repo under a different owner/name.
INFINITE_CANVAS_IMAGE=ghcr.io/22143966/infinite-canvas-docker:latest

# ComfyUI backend(s) the container should reach.
#   - ComfyUI on the Docker host      -> host.docker.internal:8188
#   - ComfyUI on another LAN machine  -> its LAN IP, e.g. 192.168.2.102:8188
# Can also be set/overridden in the WebUI (Settings -> ComfyUI).
COMFYUI_INSTANCES=192.168.2.102:8188
