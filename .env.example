# Host port for the web UI (maps to container :3000).
INFINITE_CANVAS_PORT=13200

# Published image. Must match where GitHub Actions pushes the image:
#   ghcr.io/<your-github-username>/<your-repo>:latest   (must be lowercase)
# Only change this if you forked this repo under a different owner/name.
INFINITE_CANVAS_IMAGE=ghcr.io/your-username/your-repo:latest

# ComfyUI backend(s) the container should reach.
# Same machine as Docker  -> keep host.docker.internal:8188
# Another computer        -> use its LAN address, e.g. 192.168.2.102:8188
COMFYUI_INSTANCES=host.docker.internal:8188
